{
  "manifest_version": 3,
  "name": "Alta Pulse — Monitor de Chatters",
  "version": "1.0.0",
  "description": "Acompanhe presença, turnos e tempo de resposta dos chatters diretamente no Chrome, sem API da Privacy.",
  "default_locale": "pt_BR",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://privacy.com.br/*", "https://*.privacy.com.br/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://privacy.com.br/*", "https://*.privacy.com.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
